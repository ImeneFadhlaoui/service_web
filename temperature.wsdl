<?xml version="1.0" encoding="UTF-8"?>
<definitions name="TemperatureService"
 targetNamespace="http://example.com/temperature"
 xmlns="http://schemas.xmlsoap.org/wsdl/"
 xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
 xmlns:tns="http://example.com/temperature"
 xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- TYPES SIMPLES -->
  <types>
    <xsd:schema targetNamespace="http://example.com/temperature">

      <xsd:complexType name="Empty"/>
      
    </xsd:schema>
  </types>

  <!-- MESSAGES SIMPLES -->
  <message name="CelsiusInput">
    <part name="celsius" type="xsd:float"/>
  </message>

  <message name="FahrenheitInput">
    <part name="fahrenheit" type="xsd:float"/>
  </message>

  <message name="KelvinInput">
    <part name="celsius" type="xsd:float"/>
  </message>

  <message name="TempOutput">
    <part name="result" type="xsd:float"/>
  </message>

  <!-- PORT TYPE -->
  <portType name="TemperaturePortType">

    <operation name="CelsiusToFahrenheit">
      <input message="tns:CelsiusInput"/>
      <output message="tns:TempOutput"/>
    </operation>

    <operation name="FahrenheitToCelsius">
      <input message="tns:FahrenheitInput"/>
      <output message="tns:TempOutput"/>
    </operation>

    <operation name="CelsiusToKelvin">
      <input message="tns:KelvinInput"/>
      <output message="tns:TempOutput"/>
    </operation>

  </portType>

  <!-- BINDING -->
  <binding name="TemperatureBinding" type="tns:TemperaturePortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>

    <operation name="CelsiusToFahrenheit">
      <soap:operation soapAction="CelsiusToFahrenheit"/>
      <input><soap:body use="encoded" namespace="http://example.com/temperature"/></input>
      <output><soap:body use="encoded" namespace="http://example.com/temperature"/></output>
    </operation>

    <operation name="FahrenheitToCelsius">
      <soap:operation soapAction="FahrenheitToCelsius"/>
      <input><soap:body use="encoded" namespace="http://example.com/temperature"/></input>
      <output><soap:body use="encoded" namespace="http://example.com/temperature"/></output>
    </operation>

    <operation name="CelsiusToKelvin">
      <soap:operation soapAction="CelsiusToKelvin"/>
      <input><soap:body use="encoded" namespace="http://example.com/temperature"/></input>
      <output><soap:body use="encoded" namespace="http://example.com/temperature"/></output>
    </operation>

  </binding>

  <!-- SERVICE -->
  <service name="TemperatureService">
    <port name="TemperaturePort" binding="tns:TemperatureBinding">
      <soap:address location="http://localhost:8000/temperature"/>
    </port>
  </service>

</definitions>